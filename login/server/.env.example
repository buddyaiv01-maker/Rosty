# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real secrets.

# --- Sender Gmail account (the platform's mailbox, e.g. a@gmail.com) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-platform-account@gmail.com
# Generate this at https://myaccount.google.com/apppasswords
# Requires 2-Step Verification enabled on the Google account.
SMTP_APP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=Rosty

# --- Auth / JWT ---
# Any long random string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- OTP policy ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5185

# --- Database ---
DATABASE_URL=sqlite:///./auth.db
