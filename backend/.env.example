# Copy to .env and adjust for your machine. All are optional bootstrap
# defaults — media_root/server_host/server_port/admin_emails become
# admin-editable settings after first boot (stored in the DB, these env
# vars are only used to seed that first row).

# Where the app database, cache, and thumbnails live. Must be on a drive
# that's always available (not the external media drive).
ROSTY_APP_DATA_ROOT=./data

# Where Movies/ and TV Shows/ folders live. Can be a different physical
# drive than the app data root.
ROSTY_MEDIA_ROOT=./media

# 0.0.0.0 binds to all network interfaces so other LAN devices can reach it.
ROSTY_HOST=0.0.0.0
ROSTY_PORT=8080

# Auth is handled by the bundled Auth service (../login/server). Rosty
# verifies its JWTs locally without calling out to it, so this must be the
# exact same value as JWT_SECRET in login/server/.env.
AUTH_JWT_SECRET=change-me-to-match-JWT_SECRET-in-login/server/.env-exactly

# Where Rosty calls Auth to look up a brand-new account's email (only at
# JIT-provisioning time, not on every request) — see app/auth/security.py.
AUTH_BASE_URL=http://localhost:8001

# Comma-separated emails that get role=admin the first time they log in here.
# Everyone else defaults to role=user (browse/watch only, no CMS access).
# Decided once at account-creation time — editing this list doesn't
# retroactively change an already-provisioned account's role. Only seeds the
# initial list on first boot — manage it from Admin > Settings after that.
ADMIN_EMAILS=
